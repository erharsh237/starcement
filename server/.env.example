# Star Cement Ghana - Backend Environment Variables
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/starcement
# For cloud PostgreSQL (Neon, Supabase, AWS RDS, Render): paste your connection URI here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starcement

# Enterprise Cryptographic JWT Secret for Session Authentication
JWT_SECRET=star_cement_enterprise_secret_key_2026_ghana_heavy_industrial
